# ── AI Assistant Pro — Environment Variables ─────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` (it is in .gitignore).

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
ALLOWED_USER_ID=

# ── Cloud LLMs ───────────────────────────────────────────────────────
# DeepSeek (direct, used by the bot at runtime)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Gemini (vision fallback)
GEMINI_API_KEY=

# ── 4-agent orchestration pipeline ───────────────────────────────────
# The Planner / Developer / Tester / Reviewer subagents are invoked
# by VS Code Copilot itself, so the model string in each
# `.github/agents/*.agent.md` is resolved against your Copilot
# subscription — no extra API key needed.
# Sign in to Copilot with the model `deepseek/deepseek-chat` available
# (or change the `model:` field in each agent file to one you have).

# ── Search providers ─────────────────────────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Local services ───────────────────────────────────────────────────
# Whisper.cpp (host machine, port 8080)
WHISPER_HOST=host.docker.internal:8080
WHISPER_LANG=ru

# Local Ollama
OLLAMA_HOST=host.docker.internal:11434

# llama.cpp (inside Docker)
LLAMA_HOST=llama-service:8081

# Pi-Agent (CLI used by the bot at runtime)
PI_PATH=/app/node_modules/.bin/pi
PI_SKIP_VERSION_CHECK=1
PI_OFFLINE=1
PI_TELEMETRY=0

# Hugging Face (only used to pull models for the llama.cpp image)
HF_TOKEN=
